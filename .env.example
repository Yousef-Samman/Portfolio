# API server (default 3001)
PORT=3001

# Public site URL when deployed
APP_URL=http://localhost:3000

# Production only (Vercel): URL of your Render API — no trailing slash
# Leave empty for local dev (Vite proxies /api to port 3001)
# VITE_API_URL=https://your-api.onrender.com

# Optional: restrict CORS in production (default *)
# CORS_ORIGIN=https://yourdomain.com

# CV filename under public/cv/
CV_FILENAME=YousefCv.pdf

# Contact form limits
# Minimum minutes between two messages (same IP or same email address)
CONTACT_COOLDOWN_MINUTES=15
# Max submissions per IP per rolling hour (after cooldown rules)
CONTACT_RATE_LIMIT_PER_HOUR=8

# --- Grounded AI assistant (server only — never expose to the frontend) ---
# Anthropic API key for Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Max assistant questions per IP per rolling hour
ASSISTANT_RATE_LIMIT_PER_HOUR=20
# Hard daily cap on total assistant calls (all visitors combined)
ASSISTANT_DAILY_GLOBAL_CAP=100

# Cloudflare Turnstile CAPTCHA (https://dash.cloudflare.com → Turnstile)
# Site key is public (frontend); secret stays server-only
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- Email notifications (server only — never in frontend code) ---

# Your private inbox — receives form alerts
CONTACT_NOTIFY_EMAIL=your-private-email@gmail.com

# Max notification emails per 24 hours (anti-spam)
CONTACT_EMAIL_DAILY_CAP=30

# Option A (REQUIRED on Render): Resend HTTPS API
# Render blocks outbound Gmail SMTP (ports 587/465 time out).
# 1) Create a free account at https://resend.com
# 2) API Keys → Create → copy re_... key
# 3) On free plan, CONTACT_NOTIFY_EMAIL must be the same email you used to sign up
#    (or verify a domain later for custom from-addresses)
RESEND_API_KEY=re_xxxxxxxx
CONTACT_EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>

# Option B (local only): Gmail SMTP — works on your PC, NOT on Render free tier
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-private-email@gmail.com
# SMTP_PASS=your-16-char-app-password

# Optional: Plausible analytics
# VITE_PLAUSIBLE_DOMAIN=yourdomain.com
